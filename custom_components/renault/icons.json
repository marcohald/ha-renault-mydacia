{
  "entity": {
    "binary_sensor": {
      "hvac_status": {
        "default": "mdi:fan-off",
        "state": {
          "on": "mdi:fan"
        }
      }
    },
    "button": {
      "clear_ev_schedules": {
        "default": "mdi:calendar-remove"
      },
      "flash_lights": {
        "default": "mdi:lightbulb-on"
      },
      "sound_horn": {
        "default": "mdi:bugle"
      },
      "start_air_conditioner": {
        "default": "mdi:air-conditioner"
      },
      "start_charge": {
        "default": "mdi:ev-station"
      },
      "stop_charge": {
        "default": "mdi:ev-station"
      }
    },
    "climate": {
      "preconditioning": {
        "default": "mdi:hvac"
      }
    },
    "device_tracker": {
      "location": {
        "default": "mdi:car"
      }
    },
    "number": {
      "charge_duration": {
        "default": "mdi:timer-outline"
      },
      "charge_limit_min": {
        "default": "mdi:battery-arrow-down"
      },
      "charge_limit_target": {
        "default": "mdi:battery-arrow-up"
      },
      "preconditioning_temperature": {
        "default": "mdi:thermometer"
      }
    },
    "select": {
      "charge_mode": {
        "default": "mdi:calendar-remove",
        "state": {
          "schedule_mode": "mdi:calendar-clock",
          "scheduled": "mdi:calendar-clock"
        }
      },
      "charge_mode_rq": {
        "default": "mdi:ev-station",
        "state": {
          "SCHEDULED": "mdi:calendar-clock",
          "SMARTCHARGING_OFFPEAK": "mdi:clock-check-outline",
          "V2G": "mdi:transmission-tower"
        }
      }
    },
    "sensor": {
      "battery_autonomy": {
        "default": "mdi:ev-station"
      },
      "charge_state": {
        "default": "mdi:flash-off",
        "state": {
          "charge_in_progress": "mdi:flash"
        }
      },
      "charging_remaining_time": {
        "default": "mdi:timer"
      },
      "charging_settings_mode": {
        "default": "mdi:calendar-remove",
        "state": {
          "delayed": "mdi:calendar-clock",
          "scheduled": "mdi:calendar-month"
        }
      },
      "ev_programs_count": {
        "default": "mdi:calendar-clock"
      },
      "fuel_autonomy": {
        "default": "mdi:gas-station"
      },
      "fuel_quantity": {
        "default": "mdi:fuel"
      },
      "mileage": {
        "default": "mdi:sign-direction"
      },
      "plug_state": {
        "default": "mdi:power-plug-off",
        "state": {
          "plugged": "mdi:power-plug"
        }
      },
      "preconditioning_temperature": {
        "default": "mdi:thermometer"
      }
    }
  },
  "services": {
    "ac_cancel": {
      "service": "mdi:hvac-off"
    },
    "ac_set_schedules": {
      "service": "mdi:calendar-clock"
    },
    "ac_start": {
      "service": "mdi:hvac"
    },
    "charge_set_schedules": {
      "service": "mdi:calendar-clock"
    },
    "charge_start": {
      "service": "mdi:ev-station"
    },
    "ev_clear_schedules": {
      "service": "mdi:calendar-remove"
    },
    "ev_set_schedules": {
      "service": "mdi:calendar-clock"
    }
  }
}
